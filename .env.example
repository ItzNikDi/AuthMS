HOST_URL=your.url
HOST_PORT=desired_port# <- preferably 8080
DB_URL=jdbc:postgresql://url_from_host:port/postgres_db# see src/main/kotlin/com.nikdi.authms/database/Database.kt
POSTGRES_DB=your_db
POSTGRES_USER=your_dbuser
POSTGRES_PASSWORD=your_dbpassword
JWT_SECRET=a_secret
ISSUER=token_issuer
KTOR_REALM=token_realm
